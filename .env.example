# ==============================================================================
# ShopSphere Environment Configuration Example
# Copy this file to .env or configure your system environment variables.
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# Server Configuration
PORT=8080

# Spring Active Profiles (e.g., default, mysql, test)
# SPRING_PROFILES_ACTIVE=mysql

# Initial Admin Credentials (Optional)
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=replace_with_a_strong_password

# Initial Demo Customer Credentials (Optional)
CUSTOMER_EMAIL=your_customer_email
CUSTOMER_PASSWORD=replace_with_a_strong_password